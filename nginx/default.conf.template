# Servidor do front em produção. O navegador só fala com esta origem:
# /api é repassado ao back-end pela rede privada, então os cookies de sessão
# (HttpOnly, SameSite=Strict) continuam funcionando sem CORS.
# ${PORT} e ${API_UPSTREAM} vêm das variáveis de ambiente, na subida do container.

server {
    listen ${PORT};
    listen [::]:${PORT};

    root /usr/share/nginx/html;
    index index.html;

    # API: /api/tickets -> ${API_UPSTREAM}/tickets
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;

        # Back-end fora do ar ou iniciando: desiste logo em vez de segurar o navegador por 60 s
        # e responde um 503 em JSON (o front mostra "servidor indisponível" e tenta de novo).
        # Sem proxy_intercept_errors, os erros do próprio back-end passam intactos.
        proxy_connect_timeout 5s;
        error_page 502 504 = @api_unavailable;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # Cookies de login (refresh, desafio do código, navegador confiável) vêm com Path=/auth
        proxy_cookie_path /auth /api/auth;

        # Tempo real (SSE em /api/events/stream): sem buffer e com conexão longa
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location @api_unavailable {
        default_type application/problem+json;
        add_header Retry-After 5 always;
        add_header Cache-Control "no-store" always;
        return 503 '{"title":"Servidor indisponível","status":503,"detail":"O servidor está iniciando ou fora do ar. Tente de novo em instantes."}';
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Rotas do Vue (history mode)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
