# Servidor do front em produção. O navegador só fala com esta origem:
# /api é repassado ao back-end pela rede privada, então os cookies de sessão
# (HttpOnly, SameSite=Strict) continuam funcionando sem CORS.
# ${PORT} e ${API_UPSTREAM} vêm das variáveis de ambiente, na subida do container.

server {
    listen ${PORT};
    listen [::]:${PORT};

    root /usr/share/nginx/html;
    index index.html;

    # API: /api/tickets -> ${API_UPSTREAM}/tickets
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # Cookies de login (refresh, desafio do código, navegador confiável) vêm com Path=/auth
        proxy_cookie_path /auth /api/auth;

        # Tempo real (SSE em /api/events/stream): sem buffer e com conexão longa
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Rotas do Vue (history mode)
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
