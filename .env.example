# Desenvolvimento (npm run dev): para onde o Vite repassa as chamadas /api.
# Copie para .env e ajuste se o back-end não estiver em http://localhost:8080.
VITE_API_TARGET=http://localhost:8080

# Textos da marca (opcionais). Sem eles, a interface usa os nomes genéricos do portfólio.
VITE_COMPANY_NAME=abraaosantos.dev
VITE_SUPPORT_TEAM_NAME=Inovação
VITE_EMAIL_DOMAIN=dominio.com.br

# Produção (Railway): estas variáveis vão no serviço do front, não neste arquivo.
# As VITE_* acima também precisam existir no build (o Vite as grava nos arquivos gerados).
# API_UPSTREAM=http://<nome-do-servico-do-back>.railway.internal:8080
# PORT=8080
